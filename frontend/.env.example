# Shared defaults / local development. Copy to `.env` and fill in.
# Vite loads `.env` + `.env.local` in dev, and `.env.production` +
# `.env.production.local` on `vite build` (see `.env.production.example`).
# Only VITE_-prefixed vars are exposed to the client bundle — never put
# secrets here.

VITE_API_URL="http://localhost:3000"
