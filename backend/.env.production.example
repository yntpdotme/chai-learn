# Production overrides. Copy to `.env.production` and fill in.
# Loaded only when NODE_ENV=production; takes precedence over `.env`.
# Prefer setting these directly in the host's env for real secrets —
# a committed `.env.production` is never read (see .gitignore).

NODE_ENV="production"
PORT="3000"

# Database
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# Better Auth
BETTER_AUTH_URL="https://api.example.com"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
FRONTEND_URL="https://app.example.com"
