# Shared defaults / local development.
# Copy to `.env` and fill in. Loaded for every NODE_ENV (lowest precedence).
# For production, copy `.env.production.example` -> `.env.production` instead.

NODE_ENV="development"
PORT="3000"

# Database
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# Better Auth
BETTER_AUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="123456789011121314151617181920212223242526272829303132"
FRONTEND_URL="http://localhost:3001"
