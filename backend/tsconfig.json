{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "customConditions": ["development"],
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "exclude": ["node_modules", "drizzle.config.ts", "drizzle/**", "dist"]
}
